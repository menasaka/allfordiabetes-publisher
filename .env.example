# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Pexels (featured photos). Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: override the model (default gpt-4o)
# OPENAI_MODEL=gpt-4o

# Sanity (allfordiabetes.com, project wlcff47a). Editor token from sanity.io/manage > API > Tokens
SANITY_API_TOKEN=

# Optional
# APP_PASSWORD=password_to_open_the_streamlit_app
# GOOGLE_SHEET_ID=your_google_sheet_id
